---
const services = [
    { title: "Terapia individual", text: "Un proceso personalizado para trabajar emociones, decisiones, relaciones y objetivos de bienestar." },
    { title: "Terapia de pareja", text: "Acompañamiento para mejorar la comunicación, comprender conflictos y construir acuerdos saludables." },
    { title: "Terapia familiar", text: "Un espacio para observar dinámicas familiares, fortalecer vínculos y desarrollar nuevas formas de relacionarse." },
];
---

<section id="servicios" class="section-space bg-white">
    <div class="site-container">
        <div class="max-w-3xl">
            <p class="eyebrow">Servicios</p>
            <h2 class="mt-3 text-3xl font-bold text-primary sm:text-4xl">Atención adaptada a cada etapa y necesidad</h2>
            <p class="mt-5 text-lg text-muted">La primera conversación nos permite comprender tu motivo de consulta y orientarte hacia el tipo de acompañamiento más adecuado.</p>
        </div>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
            {services.map((service, index) => (
                <article class="card-brand p-7">
                    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent-soft font-bold text-accent" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                    <h3 class="mt-6 text-xl font-bold text-primary">{service.title}</h3>
                    <p class="mt-3 text-muted">{service.text}</p>
                </article>
            ))}
        </div>
        <p class="mt-8 text-sm text-muted">La disponibilidad de cada servicio se confirma al momento de agendar.</p>
    </div>
</section>
