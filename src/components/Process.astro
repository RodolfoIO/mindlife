---
const steps = [
    { title: "Elige tu servicio y paquete", text: "Selecciona el tipo de atención y la opción que mejor se adapte a tus necesidades." },
    { title: "Completa tus datos", text: "Comparte la información necesaria para preparar y confirmar tu reservación." },
    { title: "Selecciona fecha y hora", text: "Elige un horario disponible y confirma tu cita para iniciar tu proceso." },
];
---

<section id="proceso" class="section-space surface-soft">
    <div class="site-container">
        <div class="mx-auto max-w-3xl text-center">
            <p class="eyebrow">Cómo funciona</p>
            <h2 class="mt-3 text-3xl font-bold text-primary sm:text-4xl">Comenzar puede ser sencillo</h2>
            <p class="mt-5 text-lg text-muted">Completa tu reservación en unos pasos y llega preparado a tu primera sesión.</p>
        </div>
        <ol class="mt-8 grid gap-4 sm:mt-12 sm:gap-6 md:grid-cols-3">
            {steps.map((step, index) => (
                <li class="relative rounded-2xl bg-white p-6 shadow-[var(--shadow-card)] sm:p-7">
                    <span class="text-4xl font-bold text-accent/30" aria-hidden="true">0{index + 1}</span>
                    <h3 class="mt-3 text-xl font-bold text-primary">{step.title}</h3>
                    <p class="mt-3 text-muted">{step.text}</p>
                </li>
            ))}
        </ol>
    </div>
</section>
