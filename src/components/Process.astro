---
const steps = [
    { title: "Reserva un horario", text: "Elige una fecha disponible o escríbenos si necesitas apoyo para coordinarla." },
    { title: "Completa tus datos", text: "Comparte únicamente la información necesaria para preparar el primer encuentro." },
    { title: "Inicia tu proceso", text: "En la primera sesión se conversa sobre tus necesidades, expectativas y próximos pasos." },
];
---

<section id="proceso" class="section-space surface-soft">
    <div class="site-container">
        <div class="mx-auto max-w-3xl text-center">
            <p class="eyebrow">Cómo funciona</p>
            <h2 class="mt-3 text-3xl font-bold text-primary sm:text-4xl">Comenzar puede ser sencillo</h2>
            <p class="mt-5 text-lg text-muted">Te orientamos desde la reservación hasta tu primera sesión.</p>
        </div>
        <ol class="mt-8 grid gap-4 sm:mt-12 sm:gap-6 md:grid-cols-3">
            {steps.map((step, index) => (
                <li class="relative rounded-2xl bg-white p-6 shadow-[var(--shadow-card)] sm:p-7">
                    <span class="text-4xl font-bold text-accent/30" aria-hidden="true">0{index + 1}</span>
                    <h3 class="mt-3 text-xl font-bold text-primary">{step.title}</h3>
                    <p class="mt-3 text-muted">{step.text}</p>
                </li>
            ))}
        </ol>
    </div>
</section>
