---
const year = new Date().getFullYear();
---

<footer id="contacto" class="bg-primary-dark text-white">
    <div class="site-container py-14">
        <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-[1.2fr_0.8fr_1fr]">
            <div>
                <img src="/logo-blanco.svg" alt="Mindlife Clínica Psicológica" width="210" height="64" class="w-[190px] h-auto" loading="lazy" />
                <p class="mt-5 max-w-sm text-white/75">Atención psicológica presencial y en línea, con un proceso respetuoso y centrado en cada persona.</p>
            </div>
            <div>
                <h2 class="text-lg font-bold">Explora</h2>
                <ul class="mt-4 space-y-3 text-white/80">
                    <li><a href="/#servicios" class="hover:text-white">Servicios</a></li>
                    <li><a href="/#proceso" class="hover:text-white">Cómo funciona</a></li>
                    <li><a href="/#precios" class="hover:text-white">Precios</a></li>
                    <li><a href="/privacidad" class="hover:text-white">Privacidad</a></li>
                </ul>
            </div>
            <div>
                <h2 class="text-lg font-bold">Contacto</h2>
                <address class="mt-4 not-italic text-white/80">
                    <p>Galerías Reforma, Avenida Reforma 8-60, zona 9, oficina 210, Ciudad de Guatemala.</p>
                    <p class="mt-3"><a href="tel:+50243605982" class="hover:text-white">+502 4360 5982</a></p>
                    <p class="mt-1"><a href="mailto:clinicasmindlife@gmail.com" class="break-all hover:text-white">clinicasmindlife@gmail.com</a></p>
                </address>
                <div class="mt-5 flex gap-4">
                    <a href="https://www.facebook.com/Clinicamindlife" target="_blank" rel="noopener noreferrer" aria-label="Mindlife en Facebook" class="underline underline-offset-4">Facebook</a>
                    <a href="https://www.instagram.com/clinicamindlife/" target="_blank" rel="noopener noreferrer" aria-label="Mindlife en Instagram" class="underline underline-offset-4">Instagram</a>
                </div>
            </div>
        </div>
        <div class="mt-12 border-t border-white/20 pt-6 text-sm text-white/65 md:flex md:items-center md:justify-between">
            <p>© {year} Mindlife Clínica Psicológica.</p>
            <p class="mt-3 md:mt-0">Este sitio no sustituye servicios de emergencia.</p>
        </div>
    </div>
</footer>
