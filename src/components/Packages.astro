---
const therapies = [
    {
        id: "individual",
        label: "Individual",
        packages: [
            { name: "Sesión única", price: 250, detail: "1 sesión de 45 minutos", note: "Sin compromiso de paquete" },
            { name: "Paquete de 4 sesiones", price: 750, detail: "4 sesiones de 45 minutos", note: "Q187.50 por sesión", featured: true },
            { name: "Paquete de 6 sesiones", price: 950, detail: "6 sesiones de 45 minutos", note: "Q158.33 por sesión" },
        ],
    },
    {
        id: "pareja-familia",
        label: "Pareja o familia",
        packages: [
            { name: "Sesión única", price: 350, detail: "1 sesión de 90 minutos", note: "Para pareja o familia" },
            { name: "Paquete de 4 sesiones", price: 1100, detail: "4 sesiones de 90 minutos", note: "Q275 por sesión", featured: true },
            { name: "Paquete de 6 sesiones", price: 1500, detail: "6 sesiones de 90 minutos", note: "Q250 por sesión" },
        ],
    },
];

const whatsapp = "50243605982";
const message = (name: string, price: number, therapy: string) => encodeURIComponent(`Hola, deseo consultar disponibilidad para ${name} de terapia ${therapy} (Q${price}).`);
---

<section id="precios" class="section-space bg-primary-soft">
    <div class="site-container">
        <div class="mx-auto max-w-3xl text-center">
            <p class="eyebrow">Inversión</p>
            <h2 class="mt-3 text-3xl font-bold text-primary sm:text-4xl">Opciones para dar continuidad a tu proceso</h2>
            <p class="mt-5 text-lg text-muted">Selecciona el tipo de atención para consultar las opciones disponibles. Los precios se muestran en quetzales.</p>
        </div>
        <div class="mt-8 flex justify-center sm:mt-10" role="tablist" aria-label="Tipo de terapia">
            {therapies.map((therapy, index) => (
                <button id={`tab-${therapy.id}`} class={`therapy-tab min-h-12 border border-primary px-5 py-2 font-semibold ${index === 0 ? "bg-primary text-white" : "bg-white text-primary"} first:rounded-l-full last:rounded-r-full`} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`panel-${therapy.id}`} data-target={therapy.id}>{therapy.label}</button>
            ))}
        </div>
        {therapies.map((therapy, therapyIndex) => (
            <div id={`panel-${therapy.id}`} class={`therapy-panel mt-8 sm:mt-10 ${therapyIndex === 0 ? "" : "hidden"}`} role="tabpanel" aria-labelledby={`tab-${therapy.id}`}>
                <div class="grid gap-4 sm:gap-6 md:grid-cols-3">
                    {therapy.packages.map((pkg) => (
                        <article class={`relative flex flex-col rounded-2xl bg-white p-6 sm:p-7 ${pkg.featured ? "border-2 border-accent shadow-[var(--shadow-soft)]" : "border border-muted"}`}>
                            {pkg.featured && <span class="absolute right-5 top-0 -translate-y-1/2 rounded-full bg-accent px-3 py-1 text-xs font-bold text-white">Opción frecuente</span>}
                            <h3 class="text-xl font-bold text-primary">{pkg.name}</h3>
                            <p class="mt-5 text-4xl font-bold text-primary">Q{pkg.price}</p>
                            <p class="mt-4 text-body">{pkg.detail}</p>
                            <p class="mt-2 text-sm text-muted">{pkg.note}</p>
                            <a href={`https://wa.me/${whatsapp}?text=${message(pkg.name, pkg.price, therapy.label)}`} target="_blank" rel="noopener noreferrer" class="button-primary mt-7">Consultar disponibilidad</a>
                        </article>
                    ))}
                </div>
            </div>
        ))}
        <p class="mt-8 text-center text-sm text-muted">La compra de un paquete no garantiza resultados clínicos específicos. Consulta condiciones, vigencia y políticas antes de realizar un pago.</p>
    </div>
</section>

<script is:inline>
    const tabs = document.querySelectorAll(".therapy-tab");
    const panels = document.querySelectorAll(".therapy-panel");
    tabs.forEach((tab) => tab.addEventListener("click", () => {
        const target = tab.getAttribute("data-target");
        tabs.forEach((item) => {
            const active = item === tab;
            item.setAttribute("aria-selected", String(active));
            item.classList.toggle("bg-primary", active);
            item.classList.toggle("text-white", active);
            item.classList.toggle("bg-white", !active);
            item.classList.toggle("text-primary", !active);
        });
        panels.forEach((panel) => panel.classList.toggle("hidden", panel.id !== `panel-${target}`));
    }));
</script>
