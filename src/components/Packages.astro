---

<div class="py-16 bg-white" id="precios">
  <div class="w-full site-container px-4 sm:px-6">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-primary mb-4">
      Nuestros Paquetes de Terapia
    </h2>
    <p class="text-xl text-center text-body mb-12 max-w-2xl mx-auto">
      Selecciona el tipo de terapia para ver los paquetes disponibles
    </p>

    <!-- Pestañas -->
    <div class="flex flex-wrap justify-center mb-8">
      {
        terapiasData.map((terapia) => (
          <button
            data-tab={terapia.id}
            onclick={`changeTab('${terapia.id}')`}
            class="tab-button px-4 md:px-6 py-3 mx-2 mb-2 rounded-lg font-medium transition-colors bg-white text-primary cursor-pointer"
          >
            {terapia.title}
          </button>
        ))
      }
    </div>

    <!-- Contenido de pestañas -->
    <div>
      {
        terapiasData.map((terapia) => (
          <div id={terapia.id} class="tab-content hidden">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
              {terapia.packages.map((pkg, idx) => (
                <div
                  id={`${terapia.id}-pkg-${idx}`}
                  onclick={`selectPackage('${terapia.id}','${terapia.id}-pkg-${idx}')`}
                  class={`package-card min-w-0 bg-white border-2 border-muted rounded-xl shadow-md hover:shadow-lg transition duration-300 overflow-hidden flex flex-col ${
                    pkg.popular ? "transform hover:-translate-y-1 relative" : ""
                  }`}
                >
                  {pkg.popular && (
                    <div
                      class={`absolute top-0 right-0 bg-accent text-on-primary px-4 py-1 text-sm font-bold rounded-bl-lg`}
                    >
                      ¡Más popular!
                    </div>
                  )}

                  <div class="p-6 text-center bg-white">
                    <h3 class="text-2xl font-bold text-primary">{pkg.name}</h3>
                  </div>

                  <div class="p-8 flex-grow">
                    <div class="text-center mb-6">
                      <span class="text-4xl font-bold text-gray-800">
                        Q{pkg.price}
                      </span>
                      <span class="text-gray-600 block">
                        por {pkg.sessions}{" "}
                        {pkg.sessions === 1 ? "sesión" : "sesiones"} de{" "}
                        {pkg.duration}
                      </span>
                    </div>

                    <ul class="space-y-3 mb-8">
                      {pkg.features.map((feature) => (
                        <li class="flex items-center">
                          <svg
                            class="w-5 h-5 text-accent mr-2"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M5 13l4 4L19 7"
                            />
                          </svg>
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="px-4 sm:px-8 pb-8 mt-auto">
                    {pkg.regularPrice !== pkg.price ? (
                      <div class="text-center mb-4">
                        <span class="text-gray-500 text-sm line-through">
                          Precio regular: Q{pkg.regularPrice}
                        </span>
                      </div>
                    ) : (
                      <div class="text-center mb-4">
                        <span class="text-gray-500 text-sm">
                          Precio regular: Q{pkg.regularPrice}
                        </span>
                      </div>
                    )}

                    <a
                      class={`block w-full bg-primary text-on-primary font-bold py-3 px-4 md:px-6 rounded-lg transition duration-300 cursor-pointer text-center`}
                      href={`https://wa.me/${whatsappNumber}?text=${generateWhatsAppMessage(pkg.name, pkg.price, terapia.title)}`}
                      target="_blank"
                      onclick={`selectPackage('${terapia.id}','${terapia.id}-pkg-${idx}')`}
                    >
                      {pkg.sessions === 1 ? "Agendar ahora" : "Comprar paquete"}
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .tab-button {
    transition: all 0.3s ease;
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
    animation: fadeIn 0.5s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Selected package visual state */
  .package-card.selected {
    border-width: 3px;
    border-color: var(--color-accent);
    box-shadow: 0 12px 30px rgba(31, 51, 97, 0.12);
    transform: translateY(-6px);
  }
</style>

<script is:inline>
  // Tab activo por defecto
  let clientActiveTab = "individual-linea";

  function changeTab(tabId) {
    clientActiveTab = tabId;

    // Ocultar todos los contenidos
    document.querySelectorAll(".tab-content").forEach((tab) => {
      tab.classList.add("hidden");
      tab.classList.remove("active", "block");
    });

    // Mostrar contenido activo
    const activeContent = document.getElementById(tabId);
    if (activeContent) {
      activeContent.classList.remove("hidden");
      activeContent.classList.add("active", "block");
    }

    // Actualizar botones correctamente
    document.querySelectorAll(".tab-button").forEach((button) => {
      const isActive = button.dataset.tab === tabId;

      if (isActive) {
        button.classList.remove("bg-white", "text-primary");
        button.classList.add("bg-primary", "text-on-primary");
        button.setAttribute("aria-selected", "true");
      } else {
        button.classList.remove("bg-primary", "text-on-primary");
        button.classList.add("bg-white", "text-primary");
        button.setAttribute("aria-selected", "false");
      }
    });

    // Actualizar URL
  }

  // Cargar estado inicial de tabs
  document.addEventListener("DOMContentLoaded", () => {
    const hash = window.location.hash.substring(1);
    const validTabs = [
      "individual-linea",
      "individual-presencial",
      "pareja-familia",
      "estudiantes",
    ];

    if (hash && validTabs.includes(hash)) {
      changeTab(hash);
    } else {
      changeTab(clientActiveTab);
    }
  });

  // Seleccionar paquete
  function selectPackage(tabId, pkgId) {
    const container = document.getElementById(tabId);
    if (!container) return;

    container
      .querySelectorAll(".package-card")
      .forEach((el) => el.classList.remove("selected"));

    const selected = document.getElementById(pkgId);
    if (selected) selected.classList.add("selected");
  }
</script>
