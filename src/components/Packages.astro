const generateWhatsAppMessage = (
  packageName: string,
  price: number,
  therapyType: string,
) => {
  return encodeURIComponent(
    `Hola, quiero realizar el pago del paquete "${packageName}" (Q${price}) para terapia ${therapyType}`,
  );
};
---

<div class="py-16 bg-white" id="precios">
  <div class="container mx-auto px-6">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-purple-800 mb-4">
      Nuestros Paquetes de Terapia
    </h2>
    <p class="text-xl text-center text-gray-600 mb-12 max-w-2xl mx-auto">
      Selecciona el tipo de terapia para ver los paquetes disponibles
    </p>

    <!-- Pestañas -->
    <div class="flex flex-wrap justify-center mb-8">
      {
        terapiasData.map((terapia) => (
          <button
            onclick={`changeTab('${terapia.id}')`}
            class={`tab-button px-6 py-3 mx-2 mb-2 rounded-lg font-medium transition-colors ${
              activeTab === terapia.id
                ? "bg-purple-600 text-white"
                : "bg-purple-100 text-purple-800 hover:bg-purple-200"
            }`}
          >
            {terapia.title}
          </button>
        ))
      }
    </div>

    <!-- Contenido de pestañas -->
    <div>
      {
        terapiasData.map((terapia) => (
          <div
            id={terapia.id}
            class={`tab-content ${activeTab === terapia.id ? "active block" : "hidden"}`}
          >
            <div class="grid md:grid-cols-3 gap-8">
              {terapia.packages.map((pkg) => (
                <div
                  class={`bg-white border-2 ${
                    pkg.color === "purple"
                      ? "border-purple-200"
                      : pkg.color === "blue"
                        ? "border-blue-200"
                        : pkg.color === "green"
                          ? "border-green-200"
                          : "border-indigo-200"
                  } rounded-xl shadow-md hover:shadow-lg transition duration-300 overflow-hidden flex flex-col ${
                    pkg.popular ? "transform hover:-translate-y-1 relative" : ""
                  }`}
                >
                  {pkg.popular && (
                    <div
                      class={`absolute top-0 right-0 ${
                        pkg.color === "purple"
                          ? "bg-purple-500"
                          : pkg.color === "blue"
                            ? "bg-blue-500"
                            : pkg.color === "green"
                              ? "bg-green-500"
                              : "bg-indigo-500"
                      } text-white px-4 py-1 text-sm font-bold rounded-bl-lg`}
                    >
                      ¡Más popular!
                    </div>
                  )}

                  <div
                    class={`${
                      pkg.color === "purple"
                        ? "bg-purple-100"
                        : pkg.color === "blue"
                          ? "bg-blue-100"
                          : pkg.color === "green"
                            ? "bg-green-100"
                            : "bg-indigo-100"
                    } p-6 text-center`}
                  >
                    <h3
                      class={`text-2xl font-bold ${
                        pkg.color === "purple"
                          ? "text-purple-800"
                          : pkg.color === "blue"
                            ? "text-blue-800"
                            : pkg.color === "green"
                              ? "text-green-800"
                              : "text-indigo-800"
                      }`}
                    >
                      {pkg.name}
                    </h3>
                  </div>

                  <div class="p-8 flex-grow">
                    <div class="text-center mb-6">
                      <span class="text-4xl font-bold text-gray-800">
                        Q{pkg.price}
                      </span>
                      <span class="text-gray-600 block">
                        por {pkg.sessions}{" "}
                        {pkg.sessions === 1 ? "sesión" : "sesiones"} de{" "}
                        {pkg.duration}
                      </span>
                    </div>

                    <ul class="space-y-3 mb-8">
                      {pkg.features.map((feature) => (
                        <li class="flex items-center">
                          <svg
                            class="w-5 h-5 text-green-500 mr-2"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M5 13l4 4L19 7"
                            />
                          </svg>
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="px-8 pb-8 mt-auto">
                    {pkg.regularPrice !== pkg.price ? (
                      <div class="text-center mb-4">
                        <span class="text-gray-500 text-sm line-through">
                          Precio regular: Q{pkg.regularPrice}
                        </span>
                      </div>
                    ) : (
                      <div class="text-center mb-4">
                        <span class="text-gray-500 text-sm">
                          Precio regular: Q{pkg.regularPrice}
                        </span>
                      </div>
                    )}

                    <a
                      class={`block w-full ${
                        pkg.color === "purple"
                          ? "bg-purple-600 hover:bg-purple-700"
                          : pkg.color === "blue"
                            ? "bg-blue-600 hover:bg-blue-700"
                            : pkg.color === "green"
                              ? "bg-green-600 hover:bg-green-700"
                              : "bg-indigo-600 hover:bg-indigo-700"
                      } text-white font-bold py-3 px-6 rounded-lg transition duration-300 cursor-pointer text-center`}
                      href={`https://wa.me/${whatsappNumber}?text=${generateWhatsAppMessage(pkg.name, pkg.price, terapia.title)}`}
                      target="_blank"
                    >
                      {pkg.sessions === 1 ? "Agendar ahora" : "Comprar paquete"}
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .tab-button {
    transition: all 0.3s ease;
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
    animation: fadeIn 0.5s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script is:inline>
  function changeTab(tabId) {
    // Ocultar todos los contenidos de pestañas y actualizar clases
    document.querySelectorAll(".tab-content").forEach((tab) => {
      tab.classList.add("hidden");
      tab.classList.remove("active", "block");
    });

    // Mostrar la pestaña seleccionada
    const activeContent = document.getElementById(tabId);
    if (activeContent) {
      activeContent.classList.remove("hidden");
      activeContent.classList.add("active", "block");
    }

    // Actualizar botones de pestañas
    document.querySelectorAll(".tab-button").forEach((button) => {
      button.classList.remove("bg-purple-600", "text-white");
      button.classList.add(
        "bg-purple-100",
        "text-purple-800",
        "hover:bg-purple-200",
      );

      // Resaltar el botón activo si coincide con el tabId
      if (button.getAttribute("onclick")?.includes(tabId)) {
        button.classList.remove(
          "bg-purple-100",
          "text-purple-800",
          "hover:bg-purple-200",
        );
        button.classList.add("bg-purple-600", "text-white");
      }
    });

    // Actualizar URL sin recargar
    history.pushState(null, "", `#${tabId}`);
  }

  // Inicializar con la pestaña correcta basada en el hash de la URL
  document.addEventListener("DOMContentLoaded", () => {
    const hash = window.location.hash.substring(1);
    const validTabs = [
      "individual-linea",
      "individual-presencial",
      "pareja-familia",
      "estudiantes",
    ];

    if (hash && validTabs.includes(hash)) {
      changeTab(hash);
    }
  });
</script>
