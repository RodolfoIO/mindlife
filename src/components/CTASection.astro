---
interface Props { title: string; subtitle: string; id?: string; }
const { title, subtitle, id = "agenda" } = Astro.props;
---

<section id={id} class="section-space bg-primary text-white">
    <div class="site-container text-center">
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-white/75">Da el primer paso</p>
        <h2 class="mx-auto mt-3 max-w-3xl text-3xl font-bold sm:text-4xl">{title}</h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg text-white/85">{subtitle}</p>
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <a href="/agendar" class="button-secondary">Agendar una cita</a>
            <a href="https://wa.me/50243605982?text=Hola,%20deseo%20información%20sobre%20los%20servicios%20de%20Mindlife." target="_blank" rel="noopener noreferrer" class="button-light">Hacer una consulta</a>
        </div>
    </div>
</section>
