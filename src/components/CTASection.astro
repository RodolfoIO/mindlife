---
interface Props {
    title: string;
    subtitle: string;
}
const {title, subtitle} = Astro.props;
---

<section id="CTA" class="py-16 bg-gradient-to-r from-blue-500 to-purple-600 text-white">
    <div class="container mx-auto px-6 text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">{title}</h2>
        <p class="text-xl mb-10 max-w-2xl mx-auto">{subtitle}</p>
        <a href="/agendar" class="bg-green-500 hover:bg-green-600 text-white font-bold py-4 px-12 rounded-full inline-block transition duration-300 shadow-lg">Agendar cita ahora</a>
    </div>
</section>