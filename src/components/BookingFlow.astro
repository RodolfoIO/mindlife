---
const packageGroups = [
    {
        id: "individual",
        label: "Individual",
        duration: 45,
        packages: [
            { id: "individual-1", name: "Sesión única", sessions: 1, price: 250, note: "Sin compromiso de paquete" },
            { id: "individual-4", name: "Paquete de 4 sesiones", sessions: 4, price: 750, note: "Q187.50 por sesión · Ahorras Q250", featured: true },
            { id: "individual-6", name: "Paquete de 6 sesiones", sessions: 6, price: 950, note: "Q158.33 por sesión · Ahorras Q550" },
        ],
    },
    {
        id: "pareja-familia",
        label: "Pareja / Familia",
        duration: 90,
        packages: [
            { id: "pareja-1", name: "Sesión única", sessions: 1, price: 350, note: "Para pareja o familia" },
            { id: "pareja-4", name: "Paquete de 4 sesiones", sessions: 4, price: 1100, note: "Q275 por sesión · Ahorras Q300", featured: true },
            { id: "pareja-6", name: "Paquete de 6 sesiones", sessions: 6, price: 1500, note: "Q250 por sesión · Ahorras Q600" },
        ],
    },
];
const calendarUrl = import.meta.env.CALENDAR_URL ?? "";
---

<section class="booking-section" data-booking data-calendar-url={calendarUrl}>
    <div class="site-container">
        <header class="booking-heading">
            <p class="eyebrow">Reservación</p>
            <h1>Reserva tu sesión</h1>
            <p>Selecciona el servicio, paquete y horario que mejor se adapten a ti.</p>
            <span>Elige tu paquete · Datos de contacto· Fecha y hora</span>
        </header>

        <form id="booking-form" class="booking-layout" novalidate>
            <div class="booking-flow">
                <article class="step-card">
                    <div class="step-title">
                        <span aria-hidden="true">1</span>
                        <h2>Elige tu servicio</h2>
                    </div>

                    <div class="choice-grid">
                        <fieldset class="choice-fieldset">
                            <legend>Tipo de sesión</legend>
                            <div class="segmented-control">
                                <input class="choice-input" type="radio" name="service" id="service-individual" value="individual" checked />
                                <label for="service-individual">Individual</label>
                                <input class="choice-input" type="radio" name="service" id="service-pareja" value="pareja-familia" />
                                <label for="service-pareja">Pareja / Familia</label>
                            </div>
                        </fieldset>
                    </div>

                    <fieldset class="package-fieldset">
                        <legend>Selecciona tu paquete</legend>
                        {packageGroups.map((group, groupIndex) => (
                            <div class={`package-grid ${groupIndex > 0 ? "is-hidden" : ""}`} data-package-group={group.id}>
                                {group.packages.map((pkg, packageIndex) => (
                                    <div class="package-option">
                                        <input
                                            class="package-input"
                                            type="radio"
                                            name="package"
                                            id={pkg.id}
                                            value={pkg.id}
                                            checked={groupIndex === 0 && packageIndex === 0}
                                            disabled={groupIndex > 0}
                                            data-name={pkg.name}
                                            data-sessions={pkg.sessions}
                                            data-duration={group.duration}
                                            data-price={pkg.price}
                                        />
                                        <label for={pkg.id}>
                                            {pkg.featured && <span class="popular-badge">Opción frecuente</span>}
                                            <span class="package-name">{pkg.name}</span>
                                            <strong>Q{pkg.price.toLocaleString("en-US")}</strong>
                                            <span>{pkg.sessions} {pkg.sessions === 1 ? "sesión" : "sesiones"} de {group.duration} minutos</span>
                                            <small>{pkg.note}</small>
                                        </label>
                                    </div>
                                ))}
                            </div>
                        ))}
                    </fieldset>
                </article>

                <article class="step-card">
                    <div class="step-title">
                        <span aria-hidden="true">2</span>
                        <h2>Tus datos</h2>
                    </div>
                    <div class="patient-grid">
                        <div class="form-field">
                            <label for="booking-first-name">Nombres</label>
                            <input id="booking-first-name" name="first-name" type="text" autocomplete="given-name" placeholder="Ingresa tus nombres" required />
                            <p data-error-for="booking-first-name"></p>
                        </div>
                        <div class="form-field">
                            <label for="booking-last-name">Apellidos</label>
                            <input id="booking-last-name" name="last-name" type="text" autocomplete="family-name" placeholder="Ingresa tus apellidos" required />
                            <p data-error-for="booking-last-name"></p>
                        </div>
                        <div class="form-field">
                            <label for="booking-email">Correo electrónico</label>
                            <input id="booking-email" name="email" type="email" autocomplete="email" placeholder="ejemplo@correo.com" required />
                            <p data-error-for="booking-email"></p>
                        </div>
                        <div class="form-field phone-field">
                            <label for="booking-phone">Teléfono</label>
                            <div class="phone-control">
                                <span>+502</span>
                                <input id="booking-phone" name="phone" type="tel" inputmode="numeric" autocomplete="tel-national" pattern="[0-9]{8}" maxlength="8" placeholder="55555555" required />
                            </div>
                            <p data-error-for="booking-phone"></p>
                        </div>
                    </div>
                </article>

                <article class="step-card calendar-step" data-calendar-step aria-busy="false">
                    <div class="step-title">
                        <span aria-hidden="true">3</span>
                        <h2>Elija la fecha y hora para la sesión</h2>
                    </div>
                    <!-- <p class="demo-note">Disponibilidad demostrativa. Esta selección no reserva un espacio real.</p> -->

                    <div class="schedule-shell">
                        <div class="schedule-grid">
                            <div class="calendar" aria-label="Calendario de disponibilidad demostrativa">
                                <div class="calendar-header">
                                    <button type="button" data-calendar-prev aria-label="Mes anterior">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
                                    </button>
                                    <strong data-calendar-title></strong>
                                    <button type="button" data-calendar-next aria-label="Mes siguiente">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                                    </button>
                                </div>
                                <div class="calendar-grid calendar-weekdays" aria-hidden="true">
                                    {['Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sá', 'Do'].map((day) => <span>{day}</span>)}
                                </div>
                                <div class="calendar-grid calendar-days" data-calendar-days></div>
                                <div class="calendar-legend">
                                    <span><i class="available-dot"></i>Disponible</span>
                                    <span><i class="blocked-dot"></i>No disponible</span>
                                    <span><i class="selected-dot"></i>Seleccionado</span>
                                </div>
                                <input type="hidden" name="appointment-date" data-date-input />
                                <p class="selection-error" data-date-error aria-live="polite"></p>
                            </div>

                            <div class="time-panel">
                                <h3>
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                                    <span data-time-title>Selecciona primero una fecha</span>
                                </h3>
                                <div data-time-groups hidden></div>
                                <input type="hidden" name="appointment-time" data-time-input />
                                <p class="selection-error" data-time-error aria-live="polite"></p>
                                <p class="calendar-status" data-calendar-status aria-live="polite"></p>
                                <button class="calendar-retry" type="button" data-calendar-retry hidden>Reintentar disponibilidad</button>
                            </div>
                        </div>
                        <div class="calendar-loader" data-calendar-loader hidden role="status" aria-live="polite">
                            <span class="calendar-loader-spinner" aria-hidden="true"></span>
                            <span>Consultando disponibilidad…</span>
                        </div>
                    </div>
                </article>

                
            </div>

            <aside class="booking-summary" aria-labelledby="summary-title">
                <div class="summary-image">
                    <img src="/soporte-terapia.webp" alt="Acompañamiento profesional durante una sesión" width="1536" height="1024" loading="lazy" />
                </div>
                <div class="summary-content" aria-live="polite">
                    <div>
                        <h2 id="summary-title">Resumen de cita</h2>
                        <p>Verifica los detalles antes de confirmar.</p>
                    </div>
                    <div class="summary-divider"></div>
                    <dl class="summary-list">
                        <div>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
                            <dt>Servicio</dt><dd data-summary-service>Sesión individual</dd>
                        </div>
                        <div>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v12H4zM8 3h8v4H8z" /></svg>
                            <dt>Paquete</dt><dd data-summary-package>Sesión única</dd>
                            <small data-summary-detail>1 sesión de 45 minutos</small>
                        </div>
                        <div>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v14H4zM8 3v4M16 3v4M4 9h16" /></svg>
                            <dt>Modalidad</dt><dd>En línea</dd>
                            <small>El enlace se compartirá posteriormente</small>
                        </div>
                        <div>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                            <dt>Fecha y hora</dt><dd data-summary-date>Por seleccionar</dd>
                            <small data-summary-time>Elige un horario disponible</small>
                        </div>
                    </dl>
                    <div class="summary-divider"></div>
                    <div class="summary-total">
                        <span>Total del paquete</span>
                        <strong data-summary-price>Q250</strong>
                    </div>
                    <div class="consent-wrap">
                        <p class="consent-text">Al agendar tu cita, aceptas los términos de tratamiento de datos según nuestra <a href="/privacidad">política de privacidad</a>.</p>
                    </div>
                    <button class="confirm-button" type="submit">
                        Agendar cita
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 14 0M14 7l5 5-5 5" /></svg>
                    </button>
                    <!-- <div class="privacy-note">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                        <p>Tus datos se usan para reservar la cita y crear el evento en el calendario de Mindlife.</p>
                    </div> -->
                    <p class="confirmation-message" data-confirmation role="status" aria-live="polite"></p>
                </div>
            </aside>
        </form>
    </div>
</section>

<style>
    .booking-section { background: linear-gradient(145deg, var(--color-surface), #fff 60%, var(--color-primary-soft)); padding: clamp(3rem, 7vw, 6rem) 0; }
    .booking-heading { margin-bottom: 2.5rem; max-width: 46rem; }
    .booking-heading h1 { color: var(--color-primary); font-size: clamp(2.25rem, 5vw, 3.75rem); margin: .6rem 0 0; }
    .booking-heading > p:not(.eyebrow) { color: var(--color-muted); font-size: 1.125rem; margin: 1rem 0 .35rem; }
    .booking-heading > span { color: var(--color-accent-dark); font-size: .875rem; font-weight: 600; }
    .booking-layout { align-items: start; display: grid; gap: 1.5rem; grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr); }
    .booking-flow { display: grid; gap: 1.5rem; }
    .step-card { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: var(--shadow-card); padding: clamp(1.25rem, 3vw, 2rem); }
    .step-title { align-items: center; display: flex; gap: .85rem; margin-bottom: 1.5rem; }
    .step-title > span { align-items: center; background: var(--color-primary-soft); border-radius: 50%; color: var(--color-primary); display: inline-flex; flex: 0 0 2rem; font-weight: 700; height: 2rem; justify-content: center; }
    .step-title h2 { color: var(--color-primary); font-size: 1.3rem; margin: 0; }
    fieldset { border: 0; margin: 0; min-width: 0; padding: 0; }
    legend, .form-field label { color: var(--color-primary); font-size: .78rem; font-weight: 700; letter-spacing: .08em; margin-bottom: .65rem; text-transform: uppercase; }
    .choice-grid { display: grid; width: 100%; }
    .segmented-control { background: var(--color-surface); border-radius: .8rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); padding: .25rem; }
    .choice-input { opacity: 0; position: absolute; }
    .segmented-control label { border-radius: .65rem; color: var(--color-muted); cursor: pointer; font-size: .9rem; font-weight: 600; padding: .7rem .45rem; text-align: center; }
    .choice-input:checked + label { background: #fff; box-shadow: 0 2px 8px rgba(31, 51, 97, .12); color: var(--color-primary); }
    .choice-input:focus-visible + label, .package-input:focus-visible + label { outline: 3px solid var(--color-accent); outline-offset: 3px; }
    .package-fieldset { margin-top: 1.75rem; }
    .package-grid { display: grid; gap: .75rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .package-grid.is-hidden { display: none; }
    .package-option { min-width: 0; }
    .package-input { opacity: 0; position: absolute; }
    .package-option label { border: 1px solid var(--color-border); border-radius: .9rem; cursor: pointer; display: flex; flex-direction: column; height: 100%; min-height: 11.5rem; padding: 1rem; position: relative; transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease; }
    .package-option label:hover { border-color: var(--color-accent); transform: translateY(-2px); }
    .package-input:checked + label { background: var(--color-accent-soft); border-color: var(--color-accent); box-shadow: 0 0 0 2px rgba(142, 107, 165, .15); }
    .package-name { color: var(--color-primary); font-size: .95rem; font-weight: 700; margin-top: .3rem; }
    .package-option strong { color: var(--color-primary); font-size: 1.65rem; margin: .45rem 0; }
    .package-option label > span:not(.package-name):not(.popular-badge) { color: var(--color-text); font-size: .8rem; }
    .package-option small { color: var(--color-muted); font-size: .72rem; line-height: 1.4; margin-top: auto; padding-top: .55rem; }
    .popular-badge { align-self: flex-start; background: var(--color-accent); border-radius: 999px; color: #fff; font-size: .62rem; font-weight: 700; padding: .2rem .5rem; }
    .demo-note { background: var(--color-accent-soft); border-radius: .65rem; color: var(--color-accent-dark); font-size: .82rem; margin: -0.5rem 0 1.5rem; padding: .65rem .8rem; }
    .schedule-shell { position: relative; }
    .schedule-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .calendar-loader { align-items: center; background: rgba(255, 255, 255, .88); border: 1px solid var(--color-accent); border-radius: .9rem; color: var(--color-primary); display: grid; gap: .7rem; inset: 0; justify-items: center; padding: 2rem; place-content: center; position: absolute; text-align: center; z-index: 2; }
    .calendar-loader-spinner { animation: calendar-loader-spin 900ms linear infinite; border: .2rem solid var(--color-primary-soft); border-radius: 50%; border-top-color: var(--color-accent); height: 2rem; width: 2rem; }
    .calendar-loader > span:last-child { font-size: .82rem; font-weight: 700; }
    @keyframes calendar-loader-spin { to { transform: rotate(360deg); } }
    .calendar-header { align-items: center; display: flex; justify-content: space-between; margin-bottom: .75rem; }
    .calendar-header strong { color: var(--color-primary); text-transform: capitalize; }
    .calendar-header button { align-items: center; background: transparent; border: 0; border-radius: 50%; color: var(--color-primary); display: flex; height: 2.25rem; justify-content: center; padding: .5rem; width: 2.25rem; }
    .calendar-header button:hover:not(:disabled) { background: var(--color-primary-soft); }
    .calendar-header button:disabled { cursor: not-allowed; opacity: .3; }
    svg { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2; }
    .calendar-header svg { height: 1.2rem; width: 1.2rem; }
    .calendar-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); text-align: center; }
    .calendar-weekdays { color: var(--color-muted); font-size: .74rem; margin-bottom: .35rem; }
    .calendar-weekdays span { padding: .35rem 0; }
    .calendar-days { gap: .2rem 0; }
    .calendar-days :global(.calendar-day) { align-items: center; aspect-ratio: 1; background: transparent; border: 0; border-radius: 50%; color: var(--color-muted); display: flex; font-size: .82rem; justify-content: center; margin: auto; max-height: 2.25rem; max-width: 2.25rem; padding: 0; width: 100%; }
    .calendar-days :global(.calendar-day.is-available) { background: var(--color-accent-soft); color: var(--color-primary); cursor: pointer; font-weight: 600; }
    .calendar-days :global(.calendar-day.is-available:hover), .calendar-days :global(.calendar-day.is-available:focus-visible) { background: #e5d6ec; }
    .calendar-days :global(.calendar-day.is-blocked) { color: #a6a9b2; cursor: not-allowed; opacity: .68; }
    .calendar-days :global(.calendar-day[aria-pressed="true"]) { background: var(--color-primary); box-shadow: 0 4px 10px rgba(31, 51, 97, .25); color: #fff; }
    .calendar-legend { color: var(--color-muted); display: flex; flex-wrap: wrap; font-size: .72rem; gap: 1rem; margin-top: .8rem; }
    .calendar-legend span { align-items: center; display: inline-flex; gap: .35rem; }
    .calendar-legend i { border-radius: 50%; height: .65rem; width: .65rem; }
    .available-dot { background: var(--color-accent-soft); }
    .blocked-dot { background: #c7c9d0; }
    .selected-dot { background: var(--color-primary); }
    .calendar-status { color: var(--color-muted); font-size: .75rem; line-height: 1.45; margin: .8rem 0 0; min-height: 1.1rem; }
    .calendar-status.is-error { color: #9e2424; }
    .calendar-retry { background: transparent; border: 1px solid var(--color-primary); border-radius: 999px; color: var(--color-primary); cursor: pointer; font-size: .75rem; margin-top: .55rem; padding: .45rem .75rem; }
    .calendar-retry:hover { background: var(--color-primary-soft); }
    .time-panel { background: var(--color-surface); border-radius: .9rem; min-height: 18rem; padding: 1.25rem; }
    .time-panel h3 { align-items: center; color: var(--color-primary); display: flex; font-size: .93rem; gap: .45rem; margin: 0 0 1.25rem; }
    .time-panel h3 svg { height: 1.1rem; width: 1.1rem; }
    .time-panel :global(.time-group + .time-group) { margin-top: 1.25rem; }
    .time-panel :global(.time-group > span) { color: var(--color-muted); display: block; font-size: .75rem; margin-bottom: .5rem; }
    .time-panel :global(.time-group > div) { display: flex; flex-wrap: wrap; gap: .45rem; }
    .time-panel :global(.time-group button) { background: #fff; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-primary); cursor: pointer; font-size: .82rem; padding: .45rem .75rem; }
    .time-panel :global(.time-group button:hover), .time-panel :global(.time-group button:focus-visible), .time-panel :global(.time-group button[aria-pressed="true"]) { background: var(--color-accent-soft); border-color: var(--color-accent); }
    .time-panel :global(.time-group button[aria-pressed="true"]) { box-shadow: 0 0 0 2px rgba(142, 107, 165, .14); font-weight: 700; }
    .selection-error, .form-field > p { color: #9e2424; font-size: .75rem; margin: .35rem 0 0; min-height: 1.1rem; }
    .patient-grid { display: grid; gap: .9rem 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .form-field { display: flex; flex-direction: column; }
    .form-field label { display: block; }
    .form-field input { background: #fff; border: 1px solid var(--color-border); border-radius: .75rem; color: var(--color-text); min-height: 3rem; padding: .7rem .85rem; width: 100%; }
    .form-field input::placeholder { color: #858b98; }
    .form-field input[aria-invalid="true"] { border-color: #ba1a1a; }
    .phone-control { display: flex; }
    .phone-control > span { align-items: center; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: .75rem 0 0 .75rem; color: var(--color-muted); display: flex; padding: 0 .85rem; }
    .phone-control input { border-radius: 0 .75rem .75rem 0; }
    .booking-summary { background: var(--color-primary); border-radius: var(--radius-md); box-shadow: var(--shadow-soft); color: #fff; overflow: hidden; position: sticky; top: 6.5rem; }
    .summary-image { height: 8.5rem; position: relative; }
    .summary-image::after { background: linear-gradient(transparent, var(--color-primary)); content: ""; inset: 0; position: absolute; }
    .summary-image img { height: 100%; object-fit: cover; width: 100%; }
    .summary-content { display: grid; gap: 1.15rem; margin-top: -2.5rem; padding: 0 1.5rem 1.5rem; position: relative; z-index: 1; }
    .summary-content h2 { color: #fff; font-size: 1.35rem; margin: 0; }
    .summary-content > div:first-child p { color: rgba(255,255,255,.72); font-size: .78rem; margin: .25rem 0 0; }
    .summary-divider { background: rgba(255,255,255,.18); height: 1px; }
    .summary-list { display: grid; gap: 1rem; margin: 0; }
    .summary-list > div { display: grid; gap: .05rem .65rem; grid-template-columns: 1.2rem 1fr; }
    .summary-list svg { color: #dfb8f7; grid-row: 1 / 4; height: 1.1rem; margin-top: .15rem; width: 1.1rem; }
    .summary-list dt { color: #b2c5fd; font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    .summary-list dd { color: #fff; font-size: .88rem; font-weight: 600; margin: .12rem 0 0; }
    .summary-list small { color: rgba(255,255,255,.68); font-size: .72rem; }
    .summary-total { display: grid; grid-template-columns: 1fr auto; }
    .summary-total > span { align-self: end; font-size: .95rem; font-weight: 700; }
    .summary-total strong { color: #f3daff; font-size: 2rem; line-height: 1; }
    .summary-total small { color: rgba(255,255,255,.65); font-size: .68rem; grid-column: 1 / -1; text-align: right; }
    .confirm-button { align-items: center; background: #f3daff; border: 0; border-radius: 999px; color: #2b0b41; cursor: pointer; display: flex; font-weight: 700; gap: .55rem; justify-content: center; min-height: 3.1rem; padding: .75rem 1.25rem; transition: transform 180ms ease, box-shadow 180ms ease; width: 100%; }
    .confirm-button:disabled { cursor: progress; opacity: .65; }
    .consent-wrap { display: grid; gap: .35rem; }
    .consent-text { color: rgba(255,255,255,.78); font-size: .75rem; line-height: 1.45; margin: 0; }
    .consent-text a { color: #fff; text-decoration: underline; }
    .confirm-button:hover { box-shadow: 0 8px 20px rgba(0,0,0,.22); transform: translateY(-2px); }
    .confirm-button svg { height: 1.1rem; width: 1.1rem; }
    .privacy-note { align-items: flex-start; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.12); border-radius: .65rem; display: flex; gap: .5rem; padding: .7rem; }
    .privacy-note svg { color: #dae2ff; flex: 0 0 1rem; height: 1rem; margin-top: .15rem; width: 1rem; }
    .privacy-note p { color: rgba(255,255,255,.7); font-size: .7rem; line-height: 1.45; margin: 0; }
    .confirmation-message { background: rgba(255,255,255,.1); border-radius: .65rem; color: #fff; display: none; font-size: .78rem; margin: 0; padding: .75rem; }
    .confirmation-message.is-visible { display: block; }
    .confirmation-message.is-success { background: rgba(196, 255, 209, .13); }
    @media (max-width: 900px) { .booking-layout { grid-template-columns: 1fr; } .booking-summary { position: static; } }
    @media (max-width: 640px) { .choice-grid, .schedule-grid, .patient-grid { grid-template-columns: 1fr; } .package-grid { grid-template-columns: 1fr; } .package-option label { min-height: auto; } .calendar-days :global(.calendar-day) { max-height: 2rem; max-width: 2rem; } }
    @media (prefers-reduced-motion: reduce) { .package-option label, .confirm-button { transition: none; } .calendar-loader-spinner { animation: none; } }
</style>

<script is:inline>
    (() => {
        const root = document.querySelector("[data-booking]");
        if (!root) return;

        const form = root.querySelector("#booking-form");
        const calendarUrl = root.dataset.calendarUrl;
        let calendarEvents = [];
        let calendarTimeZone = "America/Guatemala";
        let calendarAvailabilityReady = false;
        let calendarAvailabilityLoading = false;
        let calendarRequestToken = 0;
        let availabilityStartKey = "";
        let availabilityEndKey = "";
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const firstMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        let lastMonth = new Date(firstMonth);
        let visibleMonth = new Date(firstMonth);
        let selectedDate = null;
        let selectedTime = "";
        let selectedStart = "";

        const currency = (value) => `Q${Number(value).toLocaleString("en-US")}`;
        const calendarDateParts = (date) => Object.fromEntries(
            new Intl.DateTimeFormat("en-CA", {
                timeZone: calendarTimeZone,
                year: "numeric",
                month: "2-digit",
                day: "2-digit",
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit",
                hourCycle: "h23",
                timeZoneName: "longOffset",
            }).formatToParts(date).filter(({ type }) => type !== "literal").map(({ type, value }) => [type, value]),
        );
        const dateKey = (date) => {
            const parts = calendarDateParts(date);
            return `${parts.year}-${parts.month}-${parts.day}`;
        };
        const calendarDateFromKey = (key, days = 0) => {
            const [year, month, day] = key.split("-").map(Number);
            const date = new Date(Date.UTC(year, month - 1, day + days, 12, 0, 0));
            return `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, "0")}-${String(date.getUTCDate()).padStart(2, "0")}`;
        };
        const calendarDateTime = (key, hour) => {
            const [year, month, day] = key.split("-").map(Number);
            const utcGuess = Date.UTC(year, month - 1, day, hour, 0, 0);
            const guessedParts = calendarDateParts(new Date(utcGuess));
            const asUtc = Date.UTC(Number(guessedParts.year), Number(guessedParts.month) - 1, Number(guessedParts.day), Number(guessedParts.hour), Number(guessedParts.minute), Number(guessedParts.second));
            return new Date(utcGuess - (asUtc - utcGuess));
        };
        const calendarIso = (date) => {
            const parts = calendarDateParts(date);
            const offset = parts.timeZoneName === "GMT"
                ? "+00:00"
                : parts.timeZoneName.replace("GMT", "").replace(/^([+-])(\d{1,2})(?::?(\d{2}))?$/, (_, sign, hours, minutes = "00") => `${sign}${hours.padStart(2, "0")}:${minutes}`);
            return `${parts.year}-${parts.month}-${parts.day}T${parts.hour}:${parts.minute}:${parts.second}${offset}`;
        };
        const longDate = (date) => new Intl.DateTimeFormat("es-GT", { weekday: "long", day: "numeric", month: "long", timeZone: calendarTimeZone }).format(date);
        const monthLabel = (date) => `${new Intl.DateTimeFormat("es-GT", { month: "long", timeZone: calendarTimeZone }).format(new Date(Date.UTC(date.getFullYear(), date.getMonth(), 15, 12)))} ${date.getFullYear()}`;
        const timeLabel = (date) => new Intl.DateTimeFormat("es-GT", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: calendarTimeZone }).format(date);
        const sameDay = (a, b) => a && b && dateKey(a) === dateKey(b);

        const summaryService = root.querySelector("[data-summary-service]");
        const summaryPackage = root.querySelector("[data-summary-package]");
        const summaryDetail = root.querySelector("[data-summary-detail]");
        const summaryDate = root.querySelector("[data-summary-date]");
        const summaryTime = root.querySelector("[data-summary-time]");
        const summaryPrice = root.querySelector("[data-summary-price]");
        const confirmation = root.querySelector("[data-confirmation]");
        const calendarStatus = root.querySelector("[data-calendar-status]");
        const calendarRetry = root.querySelector("[data-calendar-retry]");
        const calendarStep = root.querySelector("[data-calendar-step]");
        const calendarLoader = root.querySelector("[data-calendar-loader]");
        const clearConfirmation = () => {
            confirmation.textContent = "";
            confirmation.classList.remove("is-visible", "is-success");
        };

        const selectPackage = (input) => {
            if (!input) return;
            input.checked = true;
            summaryPackage.textContent = input.dataset.name;
            summaryDetail.textContent = `${input.dataset.sessions} ${input.dataset.sessions === "1" ? "sesión" : "sesiones"} de ${input.dataset.duration} minutos`;
            summaryPrice.textContent = currency(input.dataset.price);
            clearConfirmation();
        };

        root.querySelectorAll('input[name="service"]').forEach((input) => {
            input.addEventListener("change", () => {
                const service = input.value;
                summaryService.textContent = service === "individual" ? "Sesión individual" : "Pareja / Familia";
                root.querySelectorAll("[data-package-group]").forEach((group) => {
                    const active = group.dataset.packageGroup === service;
                    group.classList.toggle("is-hidden", !active);
                    group.querySelectorAll("input").forEach((packageInput) => { packageInput.disabled = !active; });
                    if (active) selectPackage(group.querySelector("input"));
                });
                clearDateSelection();
                renderCalendar();
            });
        });

        root.querySelectorAll('input[name="package"]').forEach((input) => input.addEventListener("change", () => selectPackage(input)));
        consentInput?.addEventListener("change", () => {
            if (consentInput.checked) clearConsentError();
            clearConfirmation();
        });
        const daysContainer = root.querySelector("[data-calendar-days]");
        const calendarTitle = root.querySelector("[data-calendar-title]");
        const previousButton = root.querySelector("[data-calendar-prev]");
        const nextButton = root.querySelector("[data-calendar-next]");
        const dateInput = root.querySelector("[data-date-input]");
        const timeInput = root.querySelector("[data-time-input]");
        const dateError = root.querySelector("[data-date-error]");
        const timeError = root.querySelector("[data-time-error]");
        const timeTitle = root.querySelector("[data-time-title]");
        const timeGroups = root.querySelector("[data-time-groups]");

        const setCalendarStatus = (message, state = "") => {
            calendarStatus.textContent = message;
            calendarStatus.classList.toggle("is-error", state === "error");
            calendarRetry.hidden = state !== "error";
        };
        const setCalendarLoading = (loading) => {
            calendarLoader.hidden = !loading;
            calendarStep.setAttribute("aria-busy", String(loading));
        };
        const isValidCalendarTimeZone = (timeZone) => {
            try {
                new Intl.DateTimeFormat("en-CA", { timeZone }).format();
                return true;
            } catch {
                return false;
            }
        };
        const hasOverlap = (slotStart, slotEnd, eventStart, eventEnd) => slotStart < eventEnd && slotEnd > eventStart;
        const selectedServiceDuration = () => root.querySelector('input[name="service"]:checked')?.value === "pareja-familia" ? 90 : 45;
        const availableSlotsForDate = (date) => {
            if (!calendarAvailabilityReady) return [];
            const key = dateKey(date);
            if (key < availabilityStartKey || key >= availabilityEndKey) return [];
            const durationMinutes = selectedServiceDuration();
            return Array.from({ length: 12 }, (_, index) => 8 + index).map((hour) => {
                const start = calendarDateTime(key, hour);
                const end = new Date(start.getTime() + durationMinutes * 60 * 1000);
                return { start, end, hour, iso: calendarIso(start), label: timeLabel(start) };
            }).filter((slot) => slot.hour + durationMinutes / 60 <= 20)
                .filter((slot) => !calendarEvents.some((event) => hasOverlap(slot.start, slot.end, event.start, event.end)));
        };
        const isAvailable = (date) => availableSlotsForDate(date).length > 0;
        const loadCalendarAvailability = async () => {
            const token = ++calendarRequestToken;
            calendarAvailabilityLoading = true;
            calendarAvailabilityReady = false;
            calendarEvents = [];
            availabilityStartKey = "";
            availabilityEndKey = "";
            setCalendarLoading(true);
            setCalendarStatus("");
            renderCalendar();
            try {
                if (!calendarUrl) throw new Error("missing-calendar-url");
                const requestUrl = new URL(calendarUrl, window.location.origin);
                const response = await fetch(requestUrl, { headers: { Accept: "application/json" }, cache: "no-store" });
                if (!response.ok) throw new Error("calendar-response");
                const payload = await response.json();
                if (payload.ok !== true || typeof payload.zonaHoraria !== "string" || !isValidCalendarTimeZone(payload.zonaHoraria) || !Array.isArray(payload.eventos) || !payload.rango || typeof payload.rango.inicio !== "string" || typeof payload.rango.fin !== "string") throw new Error("calendar-payload");
                const events = payload.eventos.map((event) => {
                    const start = new Date(event.inicio);
                    const end = new Date(event.fin);
                    if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime()) || end <= start) throw new Error("calendar-event");
                    return { start, end };
                });
                const rangeStart = new Date(payload.rango.inicio);
                const rangeEnd = new Date(payload.rango.fin);
                if (Number.isNaN(rangeStart.getTime()) || Number.isNaN(rangeEnd.getTime()) || rangeEnd <= rangeStart) throw new Error("calendar-range");
                if (token !== calendarRequestToken) return;
                calendarTimeZone = payload.zonaHoraria;
                calendarEvents = events;
                availabilityStartKey = calendarDateFromKey(dateKey(rangeStart), 1);
                availabilityEndKey = dateKey(rangeEnd);
                const lastAvailableKey = calendarDateFromKey(availabilityEndKey, -1);
                const [lastAvailableYear, lastAvailableMonth] = lastAvailableKey.split("-").map(Number);
                lastMonth = new Date(lastAvailableYear, lastAvailableMonth - 1, 1);
                calendarAvailabilityReady = true;
                calendarAvailabilityLoading = false;
                setCalendarLoading(false);
                setCalendarStatus("");
                renderCalendar();
                if (selectedDate) renderTimeButtons(selectedDate);
            } catch {
                if (token !== calendarRequestToken) return;
                calendarAvailabilityLoading = false;
                calendarAvailabilityReady = false;
                calendarEvents = [];
                availabilityStartKey = "";
                availabilityEndKey = "";
                setCalendarLoading(false);
                renderCalendar();
                setCalendarStatus("No pudimos consultar el calendario. Intenta nuevamente.", "error");
            }
        };
        const resetTime = () => {
            selectedTime = "";
            selectedStart = "";
            timeInput.value = "";
            summaryTime.textContent = "Elige un horario disponible";
            timeGroups.hidden = true;
            root.querySelectorAll("[data-time]").forEach((button) => button.setAttribute("aria-pressed", "false"));
            timeError.textContent = "";
        };

        const clearDateSelection = () => {
            selectedDate = null;
            dateInput.value = "";
            summaryDate.textContent = "Por seleccionar";
            timeTitle.textContent = "Selecciona primero una fecha";
            timeGroups.hidden = true;
            dateError.textContent = "";
            resetTime();
        };

        const chooseDate = (date) => {
            selectedDate = date;
            dateInput.value = dateKey(date);
            summaryDate.textContent = longDate(date);
            timeTitle.textContent = `Horarios para ${new Intl.DateTimeFormat("es-GT", { day: "numeric", month: "long", timeZone: calendarTimeZone }).format(date)}`;
            timeGroups.hidden = false;
            dateError.textContent = "";
            resetTime();
            renderTimeButtons(date);
            renderCalendar();
            clearConfirmation();
        };

        const bindTimeButtons = () => {
            root.querySelectorAll("[data-time]").forEach((button) => {
                button.onclick = () => {
                    selectedTime = button.dataset.time || "";
                    selectedStart = button.dataset.slotStart || "";
                    timeInput.value = selectedStart;
                    summaryTime.textContent = `${button.textContent} hrs`;
                    root.querySelectorAll("[data-time]").forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
                    timeError.textContent = "";
                    clearConfirmation();
                };
            });
        };

        const renderTimeButtons = (date) => {
            const slots = availableSlotsForDate(date);
            const groups = timeGroups.querySelectorAll(".time-group");
            groups.forEach((group) => group.remove());
            if (calendarAvailabilityLoading) {
                const loadingGroup = document.createElement("div");
                loadingGroup.className = "time-group";
                loadingGroup.innerHTML = "<span>Consultando disponibilidad…</span>";
                timeGroups.append(loadingGroup);
                timeGroups.hidden = false;
                return;
            }
            const slotGroups = [
                { label: "Mañana", slots: slots.filter((slot) => Number(calendarDateParts(slot.start).hour) < 12) },
                { label: "Tarde", slots: slots.filter((slot) => Number(calendarDateParts(slot.start).hour) >= 12) },
            ];
            slotGroups.forEach(({ label, slots: groupSlots }) => {
                if (!groupSlots.length) return;
                const group = document.createElement("div");
                group.className = "time-group";
                const groupLabel = document.createElement("span");
                groupLabel.textContent = label;
                const buttons = document.createElement("div");
                groupSlots.forEach((slot) => {
                    const button = document.createElement("button");
                    button.type = "button";
                    button.className = "time-slot";
                    button.dataset.time = slot.iso;
                    button.dataset.slotStart = slot.iso;
                    button.setAttribute("aria-pressed", "false");
                    button.textContent = slot.label;
                    buttons.append(button);
                });
                group.append(groupLabel, buttons);
                timeGroups.append(group);
            });
            if (!slots.length) {
                const emptyGroup = document.createElement("div");
                emptyGroup.className = "time-group";
                emptyGroup.innerHTML = "<span>Sin horarios disponibles</span>";
                timeGroups.append(emptyGroup);
            }
            timeGroups.hidden = false;
            bindTimeButtons();
        };

        const renderCalendar = () => {
            calendarTitle.textContent = monthLabel(visibleMonth);
            daysContainer.replaceChildren();
            const year = visibleMonth.getFullYear();
            const month = visibleMonth.getMonth();
            const firstWeekday = (new Date(Date.UTC(year, month, 1, 12)).getUTCDay() + 6) % 7;
            const dayCount = new Date(Date.UTC(year, month + 1, 0, 12)).getUTCDate();
            for (let index = 0; index < firstWeekday; index += 1) {
                const spacer = document.createElement("span");
                spacer.setAttribute("aria-hidden", "true");
                daysContainer.append(spacer);
            }
            for (let day = 1; day <= dayCount; day += 1) {
                const date = new Date(Date.UTC(year, month, day, 12));
                const available = isAvailable(date);
                const element = document.createElement("button");
                element.className = `calendar-day ${available ? "is-available" : "is-blocked"}`;
                element.type = "button";
                element.disabled = !available;
                element.textContent = String(day);
                element.setAttribute("aria-label", `${longDate(date)}${available ? " disponible" : " no disponible"}`);
                element.setAttribute("aria-pressed", String(available && sameDay(date, selectedDate)));
                element.setAttribute("aria-disabled", String(!available));
                if (available) {
                    element.addEventListener("click", () => chooseDate(date));
                }
                daysContainer.append(element);
            }
            const renderedCells = firstWeekday + dayCount;
            for (let index = renderedCells; index < 42; index += 1) {
                const spacer = document.createElement("span");
                spacer.setAttribute("aria-hidden", "true");
                daysContainer.append(spacer);
            }
            previousButton.disabled = !calendarAvailabilityReady || visibleMonth <= firstMonth;
            nextButton.disabled = !calendarAvailabilityReady || visibleMonth >= lastMonth;
        };

        previousButton.addEventListener("click", () => {
            if (visibleMonth <= firstMonth) return;
            visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() - 1, 1);
            clearDateSelection();
            renderCalendar();
        });
        nextButton.addEventListener("click", () => {
            if (visibleMonth >= lastMonth) return;
            visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 1);
            clearDateSelection();
            renderCalendar();
        });

        calendarRetry.addEventListener("click", () => { void loadCalendarAvailability(); });

        bindTimeButtons();

        const phone = root.querySelector("#booking-phone");
        phone.addEventListener("input", () => { phone.value = phone.value.replace(/\D/g, "").slice(0, 8); });

        const fieldMessage = (input) => {
            if (input.validity.valueMissing) return "Completa este campo.";
            if (input.type === "email" && input.validity.typeMismatch) return "Ingresa un correo electrónico válido.";
            if (input.id === "booking-phone" && input.validity.patternMismatch) return "Ingresa un número válido de 8 dígitos.";
            return "Revisa el valor ingresado.";
        };

        form.querySelectorAll(".form-field input").forEach((input) => {
            input.addEventListener("input", () => {
                input.removeAttribute("aria-invalid");
                const error = root.querySelector(`[data-error-for="${input.id}"]`);
                if (error) error.textContent = "";
                clearConfirmation();
            });
        });

        form.addEventListener("submit", (event) => {
            event.preventDefault();
            let firstInvalid = null;
            form.querySelectorAll(".form-field input").forEach((input) => {
                const valid = input.checkValidity();
                input.setAttribute("aria-invalid", String(!valid));
                const error = root.querySelector(`[data-error-for="${input.id}"]`);
                if (error) error.textContent = valid ? "" : fieldMessage(input);
                if (!valid && !firstInvalid) firstInvalid = input;
            });
            if (!selectedDate) {
                dateError.textContent = "Selecciona una fecha disponible.";
                if (!firstInvalid) firstInvalid = root.querySelector("[data-calendar-days] button");
            }
            if (!selectedTime || !selectedStart) {
                timeError.textContent = selectedDate ? "Selecciona un horario." : "";
                if (selectedDate && !firstInvalid) firstInvalid = root.querySelector("[data-time]");
            }
            if (firstInvalid || !selectedDate || !selectedStart) {
                clearConfirmation();
                firstInvalid?.focus();
                return;
            }
            const serviceId = root.querySelector('input[name="service"]:checked')?.value;
            const packageInput = root.querySelector('input[name="package"]:checked');
            if (!serviceId || !packageInput) return;
            if (!calendarUrl) {
                confirmation.textContent = "No se configuró el calendario. Intenta nuevamente más tarde.";
                confirmation.classList.add("is-visible");
                return;
            }
            const button = root.querySelector(".confirm-button");
            button.disabled = true;
            confirmation.textContent = "Reservando tu horario…";
            confirmation.classList.add("is-visible");
            fetch(calendarUrl, {
                method: "POST",
                headers: { "content-type": "text/plain;charset=UTF-8", Accept: "application/json" },
                body: JSON.stringify({
                    serviceId,
                    packageId: packageInput.value,
                    packageName: packageInput.dataset.name,
                    start: selectedStart,
                    firstName: root.querySelector("#booking-first-name").value,
                    lastName: root.querySelector("#booking-last-name").value,
                    email: root.querySelector("#booking-email").value,
                    phone: root.querySelector("#booking-phone").value,
                    privacyAccepted: true,
                    website: "",
                }),
            }).then(async (response) => {
                const responseBody = await response.text();
                let payload;

                try {
                    payload = JSON.parse(responseBody);
                } catch {
                    throw new Error(
                        "El servicio de agenda respondió en un formato inesperado. Intenta nuevamente más tarde."
                    );
                }

                if (!response.ok || payload.ok !== true) {
                    if (payload.codigo === "SLOT_UNAVAILABLE") {
                        clearDateSelection();
                        void loadCalendarAvailability();
                    }
                    throw new Error(payload.mensaje || "No se pudo reservar el horario.");
                }
                confirmation.textContent = payload.mensaje || "Tu cita quedó reservada correctamente.";
                confirmation.classList.add("is-success");
                clearDateSelection();
                void loadCalendarAvailability();
            }).catch((error) => {
                confirmation.textContent = error.message;
                confirmation.classList.remove("is-success");
            }).finally(() => {
                button.disabled = false;
                confirmation.focus?.();
            });
        });

        selectPackage(root.querySelector('input[name="package"]:checked'));
        renderCalendar();
        void loadCalendarAvailability();
    })();
</script>
