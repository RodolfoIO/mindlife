<section id="inicio" class="relative bg-primary text-on-primary py-20">
    <div
        class="w-full site-container px-4 sm:px-6 flex flex-col md:flex-row items-center"
    >
        <div class="md:w-1/2 mb-10 md:mb-0">
            <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
                Transforma tu vida con Mindlife
            </h1>
            <p class="text-xl mb-8">
                10 años ayudando a nuestros pacientes a encontrar equilibrio y
                bienestar emocional.
            </p>
            <div
                class="flex responsive-wrap flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4"
            >
                <a
                    href="/agendar"
                    class="bg-accent text-on-primary font-bold py-3 px-4 sm:px-8 rounded-full text-center transition duration-300 cta-full sm:w-auto"
                    >Agendar cita</a
                >
                <a
                    href="#beneficios"
                    class="bg-white text-accent font-bold py-3 px-4 sm:px-8 rounded-full text-center transition duration-300 cta-full sm:w-auto"
                    >Conoce más</a
                >
            </div>
        </div>
        <div class="md:w-1/2">
            <img
                src="/imagen-hero-libertad.jpg"
                alt="Terapia psicológica profesional"
                class="rounded-lg shadow-2xl max-w-full h-auto rotate-y-180"
            />
        </div>
    </div>
    <!-- Divider removed to avoid unexpected white stripe across layouts -->
</section>
