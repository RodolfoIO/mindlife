---
import MainLayout from "../../layout/MainLayout.astro";
const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
---

<MainLayout title="Gestionar cita | Mindlife" description="Confirma, cancela o reprograma tu cita de Mindlife.">
    <section class="section-space surface-soft" data-manage data-api-url={apiUrl}>
        <div class="site-container max-w-2xl">
            <div class="card-brand p-6 sm:p-10">
                <p class="eyebrow">Gestión de cita</p>
                <h1 class="mt-3 text-3xl font-bold text-primary sm:text-4xl">Administra tu horario</h1>
                <p class="mt-4 text-muted" data-management-status>Cargando la información de tu cita…</p>
                <dl class="mt-7 grid gap-4 rounded-xl bg-primary-soft p-5 text-sm" data-management-summary hidden>
                    <div><dt class="font-bold text-primary">Estado</dt><dd data-management-state></dd></div>
                    <div><dt class="font-bold text-primary">Fecha y hora</dt><dd data-management-date></dd></div>
                </dl>
                <div class="mt-7 grid gap-3 sm:grid-cols-2" data-management-actions hidden>
                    <button type="button" class="button-primary" data-confirm>Confirmar cita</button>
                    <button type="button" class="button-secondary" data-cancel>Cancelar cita</button>
                </div>
                <form class="mt-7 grid gap-3" data-reschedule-form hidden>
                    <label class="font-bold text-primary" for="new-start">Nuevo horario</label>
                    <input id="new-start" type="datetime-local" required class="rounded-xl border border-muted p-3" />
                    <button type="submit" class="button-secondary">Solicitar reprogramación</button>
                </form>
            </div>
        </div>
    </section>
</MainLayout>

<script is:inline>
    (() => {
        const root = document.querySelector("[data-manage]");
        if (!root) return;
        const token = new URLSearchParams(window.location.hash.replace(/^#/, "")).get("token");
        const apiUrl = root.dataset.apiUrl;
        const status = root.querySelector("[data-management-status]");
        const summary = root.querySelector("[data-management-summary]");
        const actions = root.querySelector("[data-management-actions]");
        const form = root.querySelector("[data-reschedule-form]");
        let authorization = token;
        const request = async (path, options = {}) => {
            const response = await fetch(`${apiUrl}/v1/public/appointments/manage${path}`, { ...options, headers: { Accept: "application/json", Authorization: `Bearer ${authorization}`, ...(options.body ? { "content-type": "application/json" } : {}) } });
            const payload = await response.json();
            if (!response.ok) throw new Error(payload.error?.message || "No se pudo gestionar la cita.");
            return payload;
        };
        const render = (payload) => {
            summary.hidden = false;
            actions.hidden = payload.status === "cancelled" || payload.status === "confirmed";
            form.hidden = payload.status === "cancelled";
            root.querySelector("[data-management-state]").textContent = payload.status === "confirmed" ? "Confirmada" : payload.status === "cancelled" ? "Cancelada" : "Pendiente de confirmación";
            root.querySelector("[data-management-date]").textContent = new Intl.DateTimeFormat("es-GT", { dateStyle: "full", timeStyle: "short", timeZone: "America/Guatemala" }).format(new Date(payload.start));
            status.textContent = "Puedes confirmar, cancelar o elegir otro horario.";
        };
        if (!authorization) { status.textContent = "El enlace de gestión no es válido o ya expiró."; return; }
        request("").then(render).catch((error) => { status.textContent = error.message; });
        root.querySelector("[data-confirm]").addEventListener("click", () => request("/confirm", { method: "POST" }).then(render).catch((error) => { status.textContent = error.message; }));
        root.querySelector("[data-cancel]").addEventListener("click", () => request("/cancel", { method: "POST" }).then(render).catch((error) => { status.textContent = error.message; }));
        form.addEventListener("submit", (event) => {
            event.preventDefault();
            const value = root.querySelector("#new-start").value;
            request("/reschedule", { method: "POST", body: JSON.stringify({ start: new Date(value).toISOString() }) }).then((payload) => { authorization = payload.actionToken || authorization; render(payload); }).catch((error) => { status.textContent = error.message; });
        });
    })();
</script>
