---
import MainLayout from "../layout/MainLayout.astro";


---

<MainLayout title="Formulario | Clinicas Mindlife">
    
    <!-- Hero Section -->
    <section id="inicio" class="relative bg-gradient-to-r from-purple-500 to-blue-600 text-white py-20">
        <div class="container mx-auto px-6 flex flex-col md:flex-row items-center">
            <div class="md:w-1/2 mb-10 md:mb-0">
            <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">Formulario de Información del Paciente</h1>
            <p class="text-xl mb-8">Por favor completa este formulario para agilizar tu proceso de atención.</p>
            <div class="flex justify-center space-x-4">
                <a href="#formulario" class="bg-white hover:bg-gray-100 text-purple-700 font-bold py-3 px-8 rounded-full inline-block transition duration-300">
                    Ir al formulario
                </a>
                <a href="/agendar" class="border-2 border-white hover:bg-white hover:text-purple-700 font-bold py-3 px-8 rounded-full inline-block transition duration-300">
                    Volver a agendar
                </a>
            </div>
        </div>
    </section>

    <!-- Información importante -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto bg-purple-50 rounded-xl p-8">
                <h2 class="text-2xl font-bold text-purple-800 mb-6">Información importante antes de comenzar</h2>
                
                <div class="space-y-6">
                    <div class="flex items-start">
                        <div class="flex-shrink-0 bg-purple-100 p-2 rounded-full">
                            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <p class="text-gray-700">Todos los campos marcados con <span class="text-red-500">*</span> son obligatorios.</p>
                        </div>
                    </div>
                    
                    <div class="flex items-start">
                        <div class="flex-shrink-0 bg-blue-100 p-2 rounded-full">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <p class="text-gray-700">Tu información será tratada con confidencialidad según nuestras <a href="#" class="text-blue-600 underline">políticas de privacidad</a>.</p>
                        </div>
                    </div>
                    
                    <div class="flex items-start">
                        <div class="flex-shrink-0 bg-green-100 p-2 rounded-full">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                            </svg>
                        </div>
                        <div class="ml-4">
                            <p class="text-gray-700">Este formulario tarda aproximadamente 5 minutos en completarse.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Formulario Google -->
    <section id="formulario" class="py-16 bg-gray-50">
        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto bg-white p-8 rounded-xl shadow-lg">
                <h2 class="text-3xl font-bold text-purple-800 mb-6">Información del Paciente</h2>
                <p class="text-gray-600 mb-8">Por favor completa todos los campos requeridos para poder brindarte el mejor servicio.</p>
                
                <!-- Google Form Embed -->
                <div class="border border-gray-200 rounded-lg overflow-hidden">
                    <iframe src="https://docs.google.com/forms/d/e/1FAIpQLSfvqis7nOKCFuR6bdJJSR_t3P1EmCJYwEdj_jin7moZoUaArw/viewform?embedded=true" width="100%" height="3032" frameborder="0" marginheight="0" marginwidth="0">Cargando…</iframe>
                </div>
                
                <div class="mt-6 bg-purple-50 border-l-4 border-purple-500 p-4">
                    <p class="text-purple-700"><strong>Nota:</strong> Si tienes problemas para completar el formulario, por favor <a href="https://wa.me/50243605982?text=Hola, tengo dudas con el formulario" class="text-purple-600 underline" target="_blank">contáctanos</a> y con gusto te ayudaremos.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Información de contacto -->
    <section class="py-16 bg-white">
        <div class="container mx-auto px-6">
            <div class="max-w-4xl mx-auto text-center">
                <h2 class="text-3xl font-bold text-purple-800 mb-6">¿Necesitas ayuda?</h2>
                <p class="text-xl text-gray-600 mb-8">Estamos disponibles para responder tus preguntas y ayudarte con el proceso.</p>
                
                <div class="grid md:grid-cols-3 gap-8">
                    <div class="bg-blue-50 p-6 rounded-xl">
                        <svg class="w-10 h-10 text-blue-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                        </svg>
                        <h3 class="text-xl font-bold text-blue-800 mb-2">Teléfono</h3>
                        <p class="text-gray-600">+502 4360 5982</p>
                        <p class="text-gray-500 text-sm mt-2">Lunes a Viernes, 8am - 6pm</p>
                    </div>
                    
                    <div class="bg-green-50 p-6 rounded-xl">
                        <svg class="w-10 h-10 text-green-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                        <h3 class="text-xl font-bold text-green-800 mb-2">Correo</h3>
                        <p class="text-gray-600">clinicasmindlife@gmail.com</p>
                        <p class="text-gray-500 text-sm mt-2">Respuesta en menos de 24 horas</p>
                    </div>
                    
                    <div class="bg-purple-50 p-6 rounded-xl">
                        <svg class="w-10 h-10 text-purple-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"></path>
                        </svg>
                        <h3 class="text-xl font-bold text-purple-800 mb-2">WhatsApp</h3>
                        <p class="text-gray-600">+502 4360 5982</p>
                        <p class="text-gray-500 text-sm mt-2">Respuesta rápida</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</MainLayout>