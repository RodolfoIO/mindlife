---
import MainLayout from "../layout/MainLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import BenefitsSection from "../components/BenefitsSection.astro";
import CTASection from "../components/CTASection.astro";
import Approach from "../components/Approach.astro";
import Testimonial from "../components/Testimonial.astro";
import Packages from "../components/Packages.astro";
import Footer from "../components/Footer.astro";
import FinalCTA from "../components/FinalCTA.astro";
import "../styles/global.css";
---

<MainLayout title="Mindlife | Inicio">

    <!-- Hero Section -->
    <HeroSection />

    <!-- Beneficios Section -->
    <BenefitsSection />

    <!-- CTA Section -->
    <CTASection title="¿Listo para comenzar tu transformación?" subtitle="Agenda tu primera cita hoy mismo y da el primer paso hacia tu bienestar emocional." />

    <!-- Engagement/Refuerzo Section -->
    <Approach />

    <!-- Testimonios Section -->

    <Testimonial />

    <!-- Precios -->

    <Packages />

    <!-- Argumento final y CTA -->
    <!-- <FinalCTA /> -->
    <CTASection title="Tu bienestar emocional comienza aquí" subtitle="En Mindlife llevamos 10 años ayudando a personas como tú a superar desafíos emocionales, mejorar relaciones y encontrar paz interior. Nuestro equipo de profesionales está listo para acompañarte en este viaje de autodescubrimiento y crecimiento." />

</MainLayout>
