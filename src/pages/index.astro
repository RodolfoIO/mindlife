---
import MainLayout from "../layout/MainLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import Approach from "../components/Approach.astro";
import CTASection from "../components/CTASection.astro";
---

<MainLayout title="Mindlife | Clínica psicológica en Guatemala">
    <HeroSection />
    <Services />
    <Process />
    <Approach />
    <section class="bg-accent-soft py-8" aria-labelledby="aviso-ayuda">
        <div class="site-container flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <h2 id="aviso-ayuda" class="text-xl font-bold text-primary">Si estás atravesando una emergencia</h2>
                <p class="mt-1 text-muted">Mindlife no es un servicio de atención inmediata. Contacta a los servicios de emergencia de tu localidad o acude al centro asistencial más cercano.</p>
            </div>
        </div>
    </section>
    <CTASection id="comenzar" title="Tu bienestar merece un espacio y un tiempo" subtitle="Elige tu servicio, paquete y horario para reservar tu cita y dar el primer paso." />
</MainLayout>
