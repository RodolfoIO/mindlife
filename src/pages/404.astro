---
import MainLayout from "../layout/MainLayout.astro";
---

<MainLayout title="Página no encontrada | Mindlife" description="La página solicitada no está disponible.">
    <section class="section-space bg-primary-soft min-h-[65vh] flex items-center">
        <div class="site-container max-w-2xl text-center">
            <p class="text-7xl font-bold text-accent sm:text-9xl" aria-hidden="true">404</p>
            <h1 class="mt-4 text-3xl font-bold text-primary sm:text-4xl">No encontramos esta página</h1>
            <p class="mt-4 text-lg text-muted">Es posible que el enlace haya cambiado o que la página ya no esté disponible.</p>
            <a href="/" class="button-primary mt-8">Volver al inicio</a>
        </div>
    </section>
</MainLayout>
